# ============================================
# ClippingBD Studio - Production Environment Variables
# Complete Setup for Vercel Deployment
# ============================================

# ============================================
# DATABASE - Supabase PostgreSQL
# Get these from: Supabase Dashboard → Settings → Database
# Your Supabase Project: qnjvrhzjsztbwnjopuis
# ============================================

# Connection string with pooling (port 6543) - REQUIRED
DATABASE_URL="postgresql://postgres.[YOUR-PASSWORD]@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection (port 5432) - REQUIRED
DIRECT_URL="postgresql://postgres.[YOUR-PASSWORD]@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres"

# ============================================
# AUTHENTICATION - JWT & NextAuth
# Generate secure secrets: https://generate-secret.vercel.app/32
# ============================================

# JWT Secret (min 32 chars) - REQUIRED
JWT_SECRET="[GENERATE-A-SECURE-RANDOM-STRING-AT-LEAST-32-CHARACTERS]"

# NextAuth Secret - REQUIRED
NEXTAUTH_SECRET="[GENERATE-ANOTHER-SECURE-RANDOM-STRING]"

# NextAuth URL - REQUIRED (use your domain)
NEXTAUTH_URL="https://clippingbdstudio.vercel.app"

# ============================================
# APPLICATION CONFIG
# ============================================

# Public app URL - REQUIRED
NEXT_PUBLIC_APP_URL="https://clippingbdstudio.vercel.app"

# Allowed origins (comma separated) - REQUIRED
ALLOWED_ORIGINS="https://clippingbdstudio.vercel.app,https://www.clippingbdstudio.com,http://localhost:3000"

# Node environment - REQUIRED
NODE_ENV="production"

# Local storage path for uploads (development only)
LOCAL_STORAGE_PATH="./uploads"

# ============================================
# SUPABASE - Your Project: qnjvrhzjsztbwnjopuis
# Get from: Supabase Dashboard → Settings → API
# ============================================

# Supabase Project URL - REQUIRED
NEXT_PUBLIC_SUPABASE_URL="https://qnjvrhzjsztbwnjopuis.supabase.co"

# Supabase Anon Key (public) - REQUIRED
NEXT_PUBLIC_SUPABASE_ANON_KEY="[YOUR-ANON-KEY-FROM-SUPABASE]"

# Supabase Service Role Key (secret) - REQUIRED
SUPABASE_SERVICE_ROLE_KEY="[YOUR-SERVICE-ROLE-KEY-FROM-SUPABASE]"

# ============================================
# OAUTH PROVIDERS (Optional)
# Your OAuth Endpoints (already configured in Supabase):
# - Authorization: https://qnjvrhzjsztbwnjopuis.supabase.co/auth/v1/oauth/authorize
# - Token: https://qnjvrhzjsztbwnjopuis.supabase.co/auth/v1/oauth/token
# - JWKS: https://qnjvrhzjsztbwnjopuis.supabase.co/auth/v1/.well-known/jwks.json

# To enable: Supabase Dashboard → Authentication → Providers → Google/GitHub
# Then enter your OAuth credentials below:

# Google OAuth
# Get from: Google Cloud Console → APIs & Services → Credentials
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""

# GitHub OAuth
# Get from: GitHub Settings → Developer settings → OAuth Apps
# GITHUB_CLIENT_ID=""
# GITHUB_CLIENT_SECRET=""

# ============================================
# PAYMENTS (Optional - Stripe/PayPal)
# ============================================

# Stripe
# STRIPE_SECRET_KEY="sk_live_..."
# STRIPE_PUBLISHABLE_KEY="pk_live_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."

# PayPal
# PAYPAL_CLIENT_ID=""
# PAYPAL_CLIENT_SECRET=""
# PAYPAL_MODE="live"

# ============================================
# VERCEL DEPLOYMENT STEPS
# ============================================
# 1. Go to Vercel → Your Project → Settings → Environment Variables
# 2. Add each variable (replace placeholders in brackets [])
# 3. For DATABASE_URL and DIRECT_URL - replace [YOUR-PASSWORD] with your Supabase DB password
# 4. For JWT_SECRET and NEXTAUTH_SECRET - generate at: https://generate-secret.vercel.app/32
# 5. For SUPABASE keys - get from Supabase Dashboard → Settings → API
# 6. Deploy!

# After deploy, run in Vercel terminal:
# npx prisma db push
# ============================================
