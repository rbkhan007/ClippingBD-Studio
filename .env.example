# ============================================
# ClippingBD Studio - Production Environment Variables
# Complete Setup for Vercel Deployment
# ============================================

# ============================================
# DATABASE - Supabase PostgreSQL
# Get these from: Supabase Dashboard → Settings → Database
# ============================================

# Connection string with pooling (port 6543) - REQUIRED
DATABASE_URL="postgresql://postgres.[YOUR-REF]:[YOUR-PASSWORD]@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection (port 5432) - REQUIRED
DIRECT_URL="postgresql://postgres.[YOUR-REF]:[YOUR-PASSWORD]@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres"

# ============================================
# AUTHENTICATION - JWT & NextAuth
# Generate secure secrets: https://generate-secret.vercel.app/32
# ============================================

# JWT Secret (min 32 chars) - REQUIRED
JWT_SECRET="[GENERATE-A-SECURE-RANDOM-STRING-AT-LEAST-32-CHARACTERS]"

# NextAuth Secret - REQUIRED
NEXTAUTH_SECRET="[GENERATE-ANOTHER-SECURE-RANDOM-STRING]"

# NextAuth URL - REQUIRED (use your domain)
NEXTAUTH_URL="https://clippingbdstudio.vercel.app"

# ============================================
# APPLICATION CONFIG
# ============================================

# Public app URL - REQUIRED
NEXT_PUBLIC_APP_URL="https://clippingbdstudio.vercel.app"

# Allowed origins (comma separated) - REQUIRED
ALLOWED_ORIGINS="https://clippingbdstudio.vercel.app,https://www.clippingbdstudio.com,http://localhost:3000"

# Node environment - REQUIRED
NODE_ENV="production"

# Local storage path for uploads (development only)
LOCAL_STORAGE_PATH="./uploads"

# ============================================
# SUPABASE - Get from: Supabase Dashboard → Settings → API
# ============================================

# Supabase Project URL - REQUIRED
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"

# Supabase Anon Key (public) - REQUIRED
NEXT_PUBLIC_SUPABASE_ANON_KEY="[YOUR-ANON-KEY]"

# Supabase Service Role Key (secret) - REQUIRED
SUPABASE_SERVICE_ROLE_KEY="[YOUR-SERVICE-ROLE-KEY]"

# ============================================
# OAUTH PROVIDERS (Optional)
# To enable: Supabase Dashboard → Authentication → Providers
# ============================================

# Google OAuth
# Get from: Google Cloud Console → APIs & Services → Credentials
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""

# GitHub OAuth
# Get from: GitHub Settings → Developer settings → OAuth Apps
# GITHUB_CLIENT_ID=""
# GITHUB_CLIENT_SECRET=""

# ============================================
# PAYMENTS (Optional - Stripe/PayPal)
# ============================================

# Stripe
# STRIPE_SECRET_KEY="sk_live_..."
# STRIPE_PUBLISHABLE_KEY="pk_live_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."

# PayPal
# PAYPAL_CLIENT_ID=""
# PAYPAL_CLIENT_SECRET=""
# PAYPAL_MODE="live"

# ============================================
# VERCEL DEPLOYMENT INSTRUCTIONS
# ============================================
#
# 1. Go to Vercel Dashboard → Your Project → Settings → Environment Variables
#
# 2. Add each variable below (one by one or in bulk):
#    - Copy all lines below (except comments starting with #)
#    - Paste into the value field
#    - Select "Production" scope
#
# 3. Add your actual values:
#    - Replace [YOUR-REF] with your Supabase project reference
#    - Replace [YOUR-PASSWORD] with your Supabase database password
#    - Replace [YOUR-ANON-KEY] with value from Supabase → Settings → API
#    - Replace [YOUR-SERVICE-ROLE-KEY] with value from Supabase → Settings → API
#    - Generate secure JWT_SECRET and NEXTAUTH_SECRET at: https://generate-secret.vercel.app/32
#
# 4. Enable Supabase Realtime:
#    - Go to Supabase Dashboard → Database → Realtime
#    - Enable for tables: notifications, chat_messages, chat_rooms, orders, tasks, cms_hero, cms_statistics, cms_features, cms_services, cms_testimonials
#
# 5. Deploy!
#
# ============================================

# ============================================
# DATABASE SCHEMA UPDATE (Run after deploy)
# ============================================
# After deploying, run this in Vercel terminal:
# npx prisma db push
# ============================================
