# ============================================
# ClippingBD Studio - Environment Variables
# Copy this to .env and fill in values
# ============================================

# Database (Required)
DATABASE_URL=postgresql://username:password@host:port/dbname?sslmode=require

# Authentication (Required - MUST CHANGE IN PRODUCTION)
JWT_SECRET=your-secret-key-minimum-32-characters-use-openssl-rand-base64-32
NEXTAUTH_SECRET=another-secret-key-minimum-32-characters

# CORS (Required - comma-separated list of allowed origins)
ALLOWED_ORIGINS=http://localhost:3000,https://clippingbd.com

# Node Environment
NODE_ENV=development

# ============================================
# Payment Gateways (Optional - Configure in Admin UI after deploy)
# ============================================

# Stripe
# Get from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# PayPal
# Get from https://developer.paypal.com/dashboard/applications
PAYPAL_CLIENT_ID=...
PAYPAL_CLIENT_SECRET=...

# bKash (Bangladesh)
# Contact bKash for merchant credentials
BKASH_MERCHANT_ID=...
BKASH_PUBLIC_KEY=...
BKASH_SECRET_KEY=...

# Nagad (Bangladesh)
# Contact Nagad for merchant credentials
NAGAD_MERCHANT_ID=...
NAGAD_PUBLIC_KEY=...
NAGAD_SECRET_KEY=...

# Payoneer
# Get from https://payoneer.com
PAYONEER_MERCHANT_ID=...
PAYONEER_SECRET_KEY=...

# ============================================
# Email Settings (Optional - For password reset, notifications)
# ============================================
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# EMAIL_FROM=noreply@clippingbd.com

# ============================================
# Storage (Optional - Default uses Supabase)
# ============================================
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_SERVICE_KEY=your-service-key

# ============================================
# Real-time (Optional - Enabled via env)
# ============================================
# USE_REALTIME=true

# ============================================
# Notes
# ============================================
# 1. In production, JWT_SECRET must be at least 32 random characters
# 2. NEVER commit .env to version control (it's in .gitignore)
# 3. After setting these, restart the server
# 4. For production, use environment variables from your hosting platform
# 5. Test keys (stripe test, paypal sandbox) are safe to commit - but production keys must be kept secret
