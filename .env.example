# ClippingBD Studio - Environment Variables
# Copy this file to .env and fill in the values

# ============================================
# DATABASE CONFIGURATION (Supabase PostgreSQL)
# ============================================

# Get connection strings from: Supabase Dashboard > Settings > Database
# Use connection pooling for Prisma (port 6543)
DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-1-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection for migrations (port 5432)
DIRECT_URL="postgresql://postgres.[ref]:[password]@aws-1-[region].pooler.supabase.com:5432/postgres"

# ============================================
# AUTHENTICATION
# ============================================

# Auth - JWT Secret (REQUIRED - must be at least 32 characters)
# Generate with: openssl rand -base64 32
JWT_SECRET=""

# NextAuth Secret (optional - uses JWT_SECRET if not set)
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# ============================================
# APPLICATION SETTINGS
# ============================================

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Local Storage Path for file uploads
LOCAL_STORAGE_PATH="./uploads"

# CORS - Comma-separated list of allowed origins
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Node Environment (development, production, test)
NODE_ENV="development"

# ============================================
# PAYMENT GATEWAYS (optional)
# ============================================

# Stripe
# STRIPE_SECRET_KEY="sk_live_..."
# STRIPE_PUBLISHABLE_KEY="pk_live_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."

# ============================================
# SUPABASE (realtime + storage)
# ============================================

# Get from: Supabase Dashboard > Settings > API
NEXT_PUBLIC_SUPABASE_URL="https://[project].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Admin key (for server-side operations) - keep secret!
# SUPABASE_SERVICE_ROLE_KEY=""

# ============================================
# PRODUCTION NOTES
# ============================================
# 1. Generate a strong JWT_SECRET (32+ characters)
# 2. Use HTTPS in production
# 3. Configure proper CORS origins
# 4. Set NODE_ENV="production"
# 5. Enable Realtime on Supabase dashboard for CMS tables
# 6. Configure Stripe keys for payments